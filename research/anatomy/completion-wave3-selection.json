  "education": {
    "completion3:edb": {
      "description": "Músculo del dorso del pie, desde el calcáneo hacia los dedos segundo a cuarto. El extensor corto del dedo gordo se identifica por separado.",
      "function": "Colabora en la extensión de los dedos segundo a cuarto.",
      "relations": "Sus tendones se relacionan con el aparato extensor de los dedos; es vecino del extensor corto del dedo gordo.",
      "limits": "Modelo educativo de otra fuente registrado con una transformación rígida común al pie, sin ajustes por pieza. Conserva contactos locales esquemáticos con huesos y músculos vecinos; no representa interfaces tisulares exactas ni sirve para planificación clínica.",
      "sources": [
        {
          "title": "NCBI Bookshelf · Músculos del pie",
          "url": "https://www.ncbi.nlm.nih.gov/books/NBK539705/table/article-32230.table2/"
        }
      ]
    },
    "completion3:dorsal-interossei": {
      "description": "Conjunto de músculos situados entre los metatarsianos, representado por una malla original por pie.",
      "function": "Participan en la separación de los dedos segundo a cuarto y colaboran en su flexión y extensión.",
      "relations": "Se originan en lados adyacentes de los metatarsianos y se relacionan con las bases de las falanges proximales y el aparato extensor.",
      "limits": "La fuente agrupa los cuatro interóseos dorsales: no permite seleccionarlos individualmente. Modelo educativo de otra fuente registrado con una transformación rígida común al pie, sin ajustes por pieza. Conserva contactos locales esquemáticos con huesos y músculos vecinos; no representa interfaces tisulares exactas ni sirve para planificación clínica.",
      "sources": [
        {
          "title": "NCBI Bookshelf · Músculos del pie",
          "url": "https://www.ncbi.nlm.nih.gov/books/NBK539705/table/article-32230.table2/"
        }
      ]
    }
  }
